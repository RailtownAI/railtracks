# Copy this file to `.env` and uncomment the keys for the providers you use.
# Railtracks loads `.env` automatically on import (python-dotenv), so no extra setup is needed.
# `.env` is git-ignored: never commit real keys, and only put placeholders in this file.
#
# Keys are commented out on purpose: a leftover placeholder would be loaded as a real
# (invalid) key and surface as a provider auth error instead of a clear "key not set".

# OPENAI_API_KEY="sk-proj-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GEMINI_API_KEY="A..."
